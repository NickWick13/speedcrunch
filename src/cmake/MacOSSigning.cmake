# Descending paths put every child before its containing bundle. Skip symlinks
# so framework aliases do not cause the same executable to be signed twice.
function(speedcrunch_macos_signing_order app result)
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE "${app}/*")
    set(code)
    foreach(entry IN LISTS entries)
        if(IS_SYMLINK "${entry}")
            continue()
        elseif(IS_DIRECTORY "${entry}")
            if(entry MATCHES "\\.framework$" OR
                    (entry MATCHES "\\.(app|xpc|appex|bundle)$" AND
                     IS_DIRECTORY "${entry}/Contents/MacOS"))
                list(APPEND code "${entry}")
            endif()
        else()
            file(READ "${entry}" magic LIMIT 4 HEX)
            if(magic MATCHES "^(feedface|cefaedfe|feedfacf|cffaedfe|cafebabe|bebafeca|cafebabf|bfbafeca)$")
                list(APPEND code "${entry}")
            endif()
        endif()
    endforeach()
    list(APPEND code "${app}")
    list(SORT code ORDER DESCENDING)
    set(${result} "${code}" PARENT_SCOPE)
endfunction()

function(speedcrunch_macos_select_identity identities requested result)
    string(REPLACE "\n" ";" identity_lines "${identities}")
    string(TOLOWER "${requested}" requested_lower)
    foreach(line IN LISTS identity_lines)
        if(line MATCHES "\\) ([0-9A-Fa-f]+) \"(Developer ID Application:[^\"]+)\"")
            set(fingerprint "${CMAKE_MATCH_1}")
            set(identity_name "${CMAKE_MATCH_2}")
            string(TOLOWER "${fingerprint}" fingerprint_lower)
            if(requested STREQUAL identity_name OR requested_lower STREQUAL fingerprint_lower)
                set(${result} "${fingerprint}" PARENT_SCOPE)
                return()
            endif()
        endif()
    endforeach()
    set(${result} "" PARENT_SCOPE)
endfunction()

function(speedcrunch_macos_run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "macOS signing failed (${result}):\n${output}${error}")
    endif()
endfunction()

function(speedcrunch_macos_resolve_identity requested result)
    execute_process(COMMAND /usr/bin/security find-identity -v -p codesigning
        RESULT_VARIABLE status OUTPUT_VARIABLE identities ERROR_VARIABLE error)
    speedcrunch_macos_select_identity("${identities}" "${requested}" fingerprint)
    if(NOT status STREQUAL "0" OR NOT fingerprint)
        message(FATAL_ERROR "Developer ID Application identity unavailable: ${requested}\n${error}")
    endif()
    set(${result} "${fingerprint}" PARENT_SCOPE)
endfunction()

function(speedcrunch_macos_sign_app app requested_identity)
    if(NOT IS_DIRECTORY "${app}/Contents/MacOS")
        message(FATAL_ERROR "Missing application bundle for signing: ${app}")
    endif()
    speedcrunch_macos_resolve_identity("${requested_identity}" identity)
    speedcrunch_macos_signing_order("${app}" signing_order)
    message(STATUS "Signing ${app} with ${requested_identity}")
    # Keep Keychain authorization in one process, with children before parents.
    speedcrunch_macos_run(/usr/bin/codesign --force --sign "${identity}"
        --options runtime --timestamp ${signing_order})
    speedcrunch_macos_run(/usr/bin/codesign --verify --deep --strict --verbose=2 "${app}")
endfunction()

function(speedcrunch_macos_sign_dmg dmg requested_identity)
    speedcrunch_macos_resolve_identity("${requested_identity}" identity)
    message(STATUS "Signing ${dmg} with ${requested_identity}")
    speedcrunch_macos_run(/usr/bin/codesign --force --sign "${identity}" --timestamp "${dmg}")
    speedcrunch_macos_run(/usr/bin/codesign --verify --strict --verbose=2 "${dmg}")
endfunction()
