# CPack includes this after staging the app and after creating the artifacts.
set(signing_identity "$ENV{SPEEDCRUNCH_MACOS_SIGN_IDENTITY}")
string(STRIP "${signing_identity}" signing_identity)
if(signing_identity STREQUAL "" OR CPACK_SOURCE_INSTALLED_DIRECTORIES)
    return()
endif()
if(NOT CPACK_GENERATOR MATCHES "^(DragNDrop|ZIP)$")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MacOSSigning.cmake")
if(NOT DEFINED CPACK_PACKAGE_FILES)
    set(app "${CPACK_TEMPORARY_DIRECTORY}/${CPACK_SPEEDCRUNCH_MACOS_APP_BUNDLE}")
    speedcrunch_macos_sign_app("${app}" "${signing_identity}")
else()
    foreach(package IN LISTS CPACK_PACKAGE_FILES)
        if(package MATCHES "\\.dmg$")
            speedcrunch_macos_sign_dmg("${package}" "${signing_identity}")
        endif()
    endforeach()
endif()
